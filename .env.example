# Application
APP_ENV=development
APP_NAME=livestock_outbreak_detection
APP_VERSION=1.0.0
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
LOG_FILE_ENABLED=true
LOG_DIR=logs
LOG_SEPARATE_ERROR=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=livestock_db
DB_USER=postgres
DB_PASSWORD=changeme

# Secrets (never commit real values)
SECRET_ENCRYPTION_KEY=change-me-to-a-random-32-char-string
SECRET_DATABASE_PASSWORD=changeme
SECRET_JWT_SECRET=change-me

# Email alerts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
SECRET_EMAIL_PASSWORD=your_app_password
EMAIL_FROM=alerts@yourdomain.com
EMAIL_TO=recipient@example.com

# Monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=60

# API (for later)
API_HOST=0.0.0.0
API_PORT=8000


DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
AUTH_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7